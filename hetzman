#!/usr/bin/env python3
"""
HetzMan - Hetzner Infrastructure Management Tool (ETCD Version 3.1)
Manages DNS, NAT rules, and public IP pools using etcd clustering with TLS
"""

import subprocess
import sys
import socket
import os
import configparser
import json
import re
import time
import etcd3
from datetime import datetime
from pathlib import Path
from typing import Optional, List, Tuple, Dict, Any
import typer
from rich.console import Console
from rich.table import Table
from rich import print as rprint

app = typer.Typer(help="HetzMan - Hetzner Infrastructure Management Tool v3.1")
vm_app = typer.Typer(help="Manage Incus VMs (create, delete, change)")
app.add_typer(vm_app, name="vm")

cfg_app = typer.Typer(help="Configure default software on a VM")
vm_app.add_typer(cfg_app, name="cfg")

users_app = typer.Typer(help="Manage users and SSH keys on a VM")
vm_app.add_typer(users_app, name="users")

console = Console()

# Configuration
CONFIG_FILE = "/opt/hetzman-tooling/config.ini"
ADDITIONAL_HOSTS = "/opt/hetzman-tooling/configs/additional-hosts"
LOG_FILE = "/var/log/hetzman-tooling/hetzman.log"
ETCD_CREDS_FILE = "/opt/hetzman-tooling/etcd-credentials"
ETCD_CA_CERT = "/opt/hetzman-tooling/certs/ca.pem"
ETCD_CLIENT_CERT = "/opt/hetzman-tooling/certs/client.pem"
ETCD_CLIENT_KEY = "/opt/hetzman-tooling/certs/client-key.pem"
HOST_ROOT_KEYS = "/root/.ssh/authorized_keys"

# Load config
config = configparser.ConfigParser()
config.read(CONFIG_FILE)

# Server identity
CURRENT_SERVER = config.get('server', 'name')
BRIDGE_IP = config.get('server', 'bridge_ip')
PRIMARY_IFACE = config.get('server', 'primary_interface')

# Load etcd credentials if available
etcd_username = None
etcd_password = None
if os.path.exists(ETCD_CREDS_FILE):
    try:
        with open(ETCD_CREDS_FILE, 'r') as f:
            creds = f.read().strip()
            if ':' in creds:
                etcd_username, etcd_password = creds.split(':', 1)
    except:
        pass

# ETCD connection with TLS and retry logic
ETCD_ENDPOINTS = config.get('etcd', 'endpoints').split(',')
etcd_hosts = []
for endpoint in ETCD_ENDPOINTS:
    host, port = endpoint.split(':')
    etcd_hosts.append((host, int(port)))

# Try to connect with TLS
etcd_client = None
for host, port in etcd_hosts:
    try:
        # Create secure connection
        etcd_client = etcd3.client(
            host=host,
            port=port,
            ca_cert=ETCD_CA_CERT if os.path.exists(ETCD_CA_CERT) else None,
            cert_cert=ETCD_CLIENT_CERT if os.path.exists(ETCD_CLIENT_CERT) else None,
            cert_key=ETCD_CLIENT_KEY if os.path.exists(ETCD_CLIENT_KEY) else None,
            user=etcd_username,
            password=etcd_password
        )
        # Test connection
        etcd_client.get('/hetzman/version')
        break
    except Exception as e:
        continue

if not etcd_client:
    console.print("[red]ERROR: Could not connect to etcd cluster[/red]")
    sys.exit(1)


def log_message(message: str, level: str = "INFO"):
    """Log message to file"""
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_entry = f"[{timestamp}] [{level}] {message}\n"
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(log_entry)
    except Exception as e:
        console.print(f"[yellow]Warning: Could not write to log: {e}[/yellow]")

def _restart_instance_watcher():
    """Restarts the instance-watcher service."""
    console.print("[cyan]Restarting hetzman-instance-watcher service...[/cyan]")
    try:
        subprocess.run(
            ["sudo", "systemctl", "restart", "hetzman-instance-watcher"],
            check=True, capture_output=True, timeout=10
        )
        log_message("Restarted hetzman-instance-watcher service")
    except Exception as e:
        console.print(f"[yellow]Warning: Could not restart hetzman-instance-watcher: {e}[/yellow]")
        log_message(f"Failed to restart hetzman-instance-watcher: {e}", "WARNING")

def get_etcd_key(key: str) -> Optional[str]:
    """Get value from etcd with retry"""
    retries = 3
    for i in range(retries):
        try:
            value, _ = etcd_client.get(key)
            return value.decode('utf-8') if value else None
        except Exception as e:
            if i < retries - 1:
                time.sleep(0.5)
                continue
            log_message(f"Error getting etcd key {key}: {e}", "ERROR")
            return None


def put_etcd_key(key: str, value: str) -> bool:
    """Put value to etcd with retry"""
    retries = 3
    for i in range(retries):
        try:
            etcd_client.put(key, value)
            return True
        except Exception as e:
            if i < retries - 1:
                time.sleep(0.5)
                continue
            log_message(f"Error putting etcd key {key}: {e}", "ERROR")
            return False


def delete_etcd_key(key: str) -> bool:
    """Delete key from etcd with retry"""
    retries = 3
    for i in range(retries):
        try:
            etcd_client.delete(key)
            return True
        except Exception as e:
            if i < retries - 1:
                time.sleep(0.5)
                continue
            log_message(f"Error deleting etcd key {key}: {e}", "ERROR")
            return False


def get_all_with_prefix(prefix: str) -> Dict[str, Any]:
    """Get all keys with prefix from etcd"""
    try:
        results = {}
        for value, metadata in etcd_client.get_prefix(prefix):
            key = metadata.key.decode('utf-8')
            val = value.decode('utf-8')
            try:
                results[key] = json.loads(val)
            except json.JSONDecodeError:
                results[key] = val
        return results
    except Exception as e:
        log_message(f"Error getting prefix {prefix}: {e}", "ERROR")
        return {}


def get_public_ip_from_interface(ip_address: str) -> bool:
    """Check if IP address is on host interface using regex matching"""
    try:
        result = subprocess.run(
            ["ip", "addr", "show", PRIMARY_IFACE],
            capture_output=True, text=True, timeout=5
        )
        # Use regex for precise IP matching
        ip_pattern = re.compile(r'\b' + re.escape(ip_address) + r'/\d+\b')
        return bool(ip_pattern.search(result.stdout))
    except Exception as e:
        log_message(f"Error checking IP {ip_address} on interface: {e}", "ERROR")
        return False


def add_ip_to_interface(ip_address: str) -> bool:
    """Add IP address to host interface"""
    try:
        if get_public_ip_from_interface(ip_address):
            log_message(f"IP {ip_address} already on interface {PRIMARY_IFACE}")
            return True
        
        subprocess.run([
            "sudo", "ip", "addr", "add", f"{ip_address}/32", 
            "dev", PRIMARY_IFACE
        ], check=True, capture_output=True, timeout=5)
        
        log_message(f"Added IP {ip_address} to interface {PRIMARY_IFACE}")
        return True
    except subprocess.CalledProcessError as e:
        log_message(f"Failed to add IP {ip_address} to interface: {e}", "ERROR")
        return False
    except subprocess.TimeoutExpired:
        log_message(f"Timeout adding IP {ip_address} to interface", "ERROR")
        return False


def remove_ip_from_interface(ip_address: str) -> bool:
    """Remove IP address from host interface"""
    try:
        if not get_public_ip_from_interface(ip_address):
            log_message(f"IP {ip_address} not on interface {PRIMARY_IFACE}")
            return True
        
        subprocess.run([
            "sudo", "ip", "addr", "del", f"{ip_address}/32", 
            "dev", PRIMARY_IFACE
        ], check=True, capture_output=True, timeout=5)
        
        log_message(f"Removed IP {ip_address} from interface {PRIMARY_IFACE}")
        return True
    except subprocess.CalledProcessError as e:
        log_message(f"Failed to remove IP {ip_address} from interface: {e}", "ERROR")
        return False
    except subprocess.TimeoutExpired:
        log_message(f"Timeout removing IP {ip_address} from interface", "ERROR")
        return False


def reload_dnsmasq():
    """Reload dnsmasq to pick up changes"""
    try:
        subprocess.run(["sudo", "systemctl", "reload", "dnsmasq"], 
                       check=True, capture_output=True, timeout=10)
        log_message("dnsmasq reloaded successfully")
        return True
    except subprocess.CalledProcessError as e:
        console.print(f"[red]Failed to reload dnsmasq: {e}[/red]")
        log_message(f"Failed to reload dnsmasq: {e}", "ERROR")
        return False
    except subprocess.TimeoutExpired:
        console.print(f"[red]Timeout reloading dnsmasq[/red]")
        log_message("Timeout reloading dnsmasq", "ERROR")
        return False


def regenerate_hosts_file():
    """Regenerate additional-hosts file from etcd"""
    try:
        dns_records = get_all_with_prefix("/hetzman/dns/")
        
        os.makedirs(os.path.dirname(ADDITIONAL_HOSTS), exist_ok=True)
        with open(ADDITIONAL_HOSTS, "w") as f:
            for key, record in dns_records.items():
                if isinstance(record, dict):
                    hostname = key.replace("/hetzman/dns/", "")
                    f.write(f"{record['ip']} {hostname}\n")
        
        log_message(f"Regenerated hosts file with {len(dns_records)} records")
        return True
    except Exception as e:
        console.print(f"[red]Error regenerating hosts file: {e}[/red]")
        log_message(f"Error regenerating hosts file: {e}", "ERROR")
        return False


def apply_nat_rules():
    """Apply all enabled NAT rules from etcd with idempotency and proper exclusions"""
    try:
        # Ensure chains exist (idempotent)
        subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-N", "HETZMAN_NAT"], 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-N", "HETZMAN_NAT_POST"], 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        
        # Add jumps to chains with check first
        subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-C", "PREROUTING", "-j", "HETZMAN_NAT"], 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-C", "PREROUTING", "-j", "HETZMAN_NAT"], 
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10).returncode != 0:
            subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-I", "PREROUTING", "-j", "HETZMAN_NAT"], 
                           check=True, capture_output=True, timeout=10)
        
        subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-C", "POSTROUTING", "-j", "HETZMAN_NAT_POST"], 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-C", "POSTROUTING", "-j", "HETZMAN_NAT_POST"], 
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10).returncode != 0:
            subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-I", "POSTROUTING", "-j", "HETZMAN_NAT_POST"], 
                           check=True, capture_output=True, timeout=10)
        
        # Clear existing NAT rules
        subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-F", "HETZMAN_NAT"], 
                       capture_output=True, timeout=10)
        subprocess.run(["sudo", "iptables", "-w", "5", "-t", "nat", "-F", "HETZMAN_NAT_POST"], 
                       capture_output=True, timeout=10)
        
        # Get NAT rules for this server
        nat_rules = get_all_with_prefix(f"/hetzman/nat/{CURRENT_SERVER}/")
        
        # Apply each NAT rule
        for key, rule in nat_rules.items():
            if not isinstance(rule, dict) or not rule.get('enabled', True):
                continue
                
            public_ip = rule['public_ip']
            private_ip = rule['private_ip']
            instance_name = rule['instance_name']
            
            # Ensure public IP is on interface
            add_ip_to_interface(public_ip)
            
            # DNAT for external traffic
            subprocess.run([
                "sudo", "iptables", "-w", "5", "-t", "nat", "-A", "HETZMAN_NAT",
                "-d", public_ip,
                "-j", "DNAT",
                "--to-destination", private_ip
            ], check=True, capture_output=True, timeout=10)
            
            # Hairpin NAT for internal traffic accessing public IP
            subprocess.run([
                "sudo", "iptables", "-w", "5", "-t", "nat", "-A", "HETZMAN_NAT",
                "-i", "incusbr0",
                "-d", public_ip,
                "-j", "DNAT",
                "--to-destination", private_ip
            ], check=True, capture_output=True, timeout=10)
            
            # SNAT with proper exclusions for internal networks
            subprocess.run([
                "sudo", "iptables", "-w", "5", "-t", "nat", "-A", "HETZMAN_NAT_POST",
                "-s", private_ip,
                "!", "-d", "10.0.0.0/8",
                "-j", "SNAT",
                "--to-source", public_ip
            ], check=True, capture_output=True, timeout=10)
            
            log_message(f"Applied 1:1 NAT with hairpin: {public_ip} <-> {private_ip} ({instance_name})")
        
        # Add masquerade rule for hairpin return traffic (with check)
        if subprocess.run([
            "sudo", "iptables", "-w", "5", "-t", "nat", "-C", "HETZMAN_NAT_POST",
            "-s", "10.100.0.0/16",
            "-d", "10.100.0.0/16",
            "-j", "MASQUERADE"
        ], capture_output=True, timeout=10).returncode != 0:
            subprocess.run([
                "sudo", "iptables", "-w", "5", "-t", "nat", "-A", "HETZMAN_NAT_POST",
                "-s", "10.100.0.0/16",
                "-d", "10.100.0.0/16",
                "-j", "MASQUERADE"
            ], check=True, capture_output=True, timeout=10)
        
        # Get port forward rules
        port_rules = get_all_with_prefix(f"/hetzman/port-forward/{CURRENT_SERVER}/")
        
        # Apply each port forward
        for key, rule in port_rules.items():
            if not isinstance(rule, dict) or not rule.get('enabled', True):
                continue
                
            subprocess.run([
                "sudo", "iptables", "-w", "5", "-t", "nat", "-A", "HETZMAN_NAT",
                "-d", rule['public_ip'],
                "-p", rule['protocol'],
                "--dport", str(rule['public_port']),
                "-j", "DNAT",
                "--to-destination", f"{rule['private_ip']}:{rule['private_port']}"
            ], check=True, capture_output=True, timeout=10)
            
            log_message(f"Applied port forward: {rule['public_ip']}:{rule['public_port']} -> {rule['private_ip']}:{rule['private_port']} ({rule['protocol']})")
        
        console.print(f"[green]Applied {len(nat_rules)} NAT rules and {len(port_rules)} port forwards[/green]")
        return True
        
    except Exception as e:
        console.print(f"[red]Error applying NAT rules: {e}[/red]")
        log_message(f"Error applying NAT rules: {e}", "ERROR")
        return False


