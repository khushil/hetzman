def _run_vm_exec(vm_name: str, cmd_list: List[str], step_msg: str, timeout: int = 120, user_id: Optional[str] = None) -> bool:
    """Helper to run an incus exec command with logging."""
    console.print(f"  {step_msg}...")
    
    base_cmd = ["sudo", "incus", "exec", vm_name]
    if user_id:
        base_cmd.extend(["--user", user_id])
    base_cmd.append("--")
    
    try:
        subprocess.run(
            base_cmd + cmd_list,
            check=True, capture_output=True, text=True, timeout=timeout
        )
        return True
    except subprocess.CalledProcessError as e:
        console.print(f"  [red]FAILED[/red]: {e.stderr[:200]}...") # Print snippet of stderr
        log_message(f"Failed to {step_msg.lower()} on {vm_name}: {e.stderr}", "ERROR")
        return False
    except Exception as e:
        console.print(f"  [red]FAILED[/red]: {e}")
        log_message(f"Failed to {step_msg.lower()} on {vm_name}: {e}", "ERROR")
        return False

def _check_vm_exists(vm_name: str) -> bool:
    """Checks if an Incus VM or container exists."""
    try:
        subprocess.run(
            ["sudo", "incus", "info", vm_name],
            check=True, text=True, timeout=5,
            stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL
        )
        return True
    except subprocess.CalledProcessError:
        return False
    except Exception:
        return False

def _check_vm_user_exists(vm_name: str, username: str) -> bool:
    """Checks if a user exists on the VM."""
    try:
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "id", username],
            check=True, capture_output=True, text=True, timeout=5,
            stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL
        )
        return True
    except subprocess.CalledProcessError:
        return False
    except Exception:
        return False

def _get_vm_users(vm_name: str) -> List[Tuple[str, str]]:
    """Gets a list of (username, home_dir) for real users on a VM."""
    users = []
    try:
        # Always add root
        users.append(("root", "/root"))
        
        result = subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "cat", "/etc/passwd"],
            capture_output=True, text=True, check=True, timeout=10
        )
        
        for line in result.stdout.strip().split('\n'):
            parts = line.split(':')
            if len(parts) >= 6:
                username = parts[0]
                uid_str = parts[2]
                home_dir = parts[5]
                try:
                    uid = int(uid_str)
                    if uid >= 1000 and home_dir.startswith("/home/"):
                        users.append((username, home_dir))
                except ValueError:
                    continue # Skip lines with invalid UIDs
        return users
    except Exception as e:
        log_message(f"Could not get users from {vm_name}: {e}", "ERROR")
        return users # Return at least root if 'cat' failed

def _secure_vm_instance(vm_name: str) -> bool:
    """Internal function to secure a single VM instance."""
    
    if not _check_vm_exists(vm_name):
        console.print(f"Skipping {vm_name} (does not exist or not running).")
        return False

    console.print(f"--- [blue]Processing VM: {vm_name}[/blue] ---")
    
    # Check for host key file
    if not os.path.exists(HOST_ROOT_KEYS):
        console.print(f"[red]Error: Host key file not found at {HOST_ROOT_KEYS}[/red]")
        return False
    
    try:
        # 1. Install/Enable openssh-server
        console.print("Step 1/8: Installing/Enabling openssh-server...")
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "apt-get", "update", "-y"],
            capture_output=True, text=True, timeout=120
        )
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "apt-get", "install", "openssh-server", "-y"],
            check=True, capture_output=True, text=True, timeout=120
        )
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "systemctl", "enable", "--now", "ssh"],
            check=True, capture_output=True, text=True, timeout=30
        )
        
        # 2. Ensure .ssh directory exists
        console.print("Step 2/8: Ensuring /root/.ssh directory...")
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "mkdir", "-p", "/root/.ssh"],
            check=True, capture_output=True, text=True, timeout=10
        )
        
        # 3. Push authorized_keys
        console.print("Step 3/8: Pushing authorized_keys...")
        subprocess.run(
            ["sudo", "incus", "file", "push", HOST_ROOT_KEYS, f"{vm_name}/root/.ssh/authorized_keys"],
            check=True, capture_output=True, text=True, timeout=10
        )

        # 4. Set permissions
        console.print("Step 4/8: Setting permissions...")
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "chmod", "700", "/root/.ssh"],
            check=True, capture_output=True, text=True, timeout=10
        )
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "chmod", "600", "/root/.ssh/authorized_keys"],
            check=True, capture_output=True, text=True, timeout=10
        )
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "chown", "-R", "root:root", "/root/.ssh"],
            check=True, capture_output=True, text=True, timeout=10
        )

        # 5. Harden sshd_config
        console.print("Step 5/8: Hardening sshd_config (key-only)...")
        sed_command = (
            "sed -i -e 's/^#*PermitRootLogin .*/PermitRootLogin prohibit-password/' "
            "-e 's/^#*PasswordAuthentication .*/PasswordAuthentication no/' "
            "-e 's/^#*ChallengeResponseAuthentication .*/ChallengeResponseAuthentication no/' "
            "/etc/ssh/sshd_config"
        )
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "bash", "-c", sed_command],
            check=True, capture_output=True, text=True, timeout=10
        )

        # 6. Restart SSH
        console.print("Step 6/8: Restarting sshd service...")
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "systemctl", "restart", "ssh"],
            check=True, capture_output=True, text=True, timeout=10
        )
        
        # 7. Install fail2ban
        console.print("Step 7/8: Installing fail2ban...")
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "apt-get", "install", "fail2ban", "-y"],
            check=True, capture_output=True, text=True, timeout=120
        )
        
        # 8. Configure fail2ban
        console.print("Step 8/8: Configuring fail2ban...")
        jail_local_content = (
            "[sshd]\n"
            "enabled = true\n"
            "port    = ssh\n"
            "logpath = %(sshd_log)s\n"
            "backend = %(sshd_backend)s\n"
        )
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "bash", "-c", 
             f"echo -e '{jail_local_content}' > /etc/fail2ban/jail.local"],
            check=True, capture_output=True, text=True, timeout=10
        )
        subprocess.run(
            ["sudo", "incus", "exec", vm_name, "--", "systemctl", "enable", "--now", "fail2ban"],
            check=True, capture_output=True, text=True, timeout=30
        )
        
        console.print(f"[green]✓ Successfully secured {vm_name}[/green]")
        log_message(f"Successfully secured {vm_name}", "INFO")
        return True

    except subprocess.CalledProcessError as e:
        console.print(f"[red]Error securing {vm_name} (step {e.cmd[0]}...): {e.stderr}[/red]")
        log_message(f"Failed to secure {vm_name}: {e.stderr}", "ERROR")
        return False
    except Exception as e:
        console.print(f"[red]An unexpected error occurred while securing {vm_name}: {e}[/red]")
        log_message(f"An unexpected error occurred while securing {vm_name}: {e}", "ERROR")
        return False

