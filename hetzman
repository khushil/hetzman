):
    """Create a backup of etcd data"""
    if not output_file:
        output_file = f"/var/lib/hetzman/etcd-backup-{datetime.now().strftime('%Y%m%d-%H%M%S')}.db"
    
    try:
        subprocess.run([
            "sudo", "etcdctl",
